{
  "manifest_version": 3,
  "name": "Speed Downloader",
  "version": "1.4.0",
  "description": "Sends downloads to the Speed Downloader app on this computer.",
  "key": "",
  "minimum_chrome_version": "109",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "video-button.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "48": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png"
  },
  "permissions": [
    "alarms",
    "downloads",
    "nativeMessaging",
    "cookies",
    "notifications",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
